# --- Database ---
# Provided by Railway Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/legal

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# --- Clerk (web app auth) ---
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...
# User OAuth Token (xoxp-...) with `search:read` scope.
# Required for the worker's context_fetch_slack job — bot tokens cannot
# call search.messages. Without this every matter logs `Slack search
# error: invalid_auth` and retries 5x. Get it from OAuth & Permissions
# after installing the app; re-install whenever you add a scope.
SLACK_USER_TOKEN=xoxp-...
SOCKET_MODE=true

# --- Service URLs (internal) ---
WEB_APP_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

# --- Internal tokens (rotate per environment) ---
# Shared between bot and web for /api/intake auth
INTERNAL_API_TOKEN=replace-me-with-a-random-string
# Shared between worker and AI service
AI_SERVICE_TOKEN=replace-me-with-a-random-string

# --- OpenAI (worker: generates embeddings for vector search) ---
OPENAI_API_KEY=sk-...

# --- Notion (optional, used by lawyer chat copilot) ---
NOTION_API_KEY=
# Parent page ID used by save_to_notion when no destination is specified
NOTION_DEFAULT_PARENT_PAGE_ID=

# --- Google Drive (optional, used by lawyer chat copilot) ---
# Paste the JSON of a service account with Drive + Docs scopes. The web app
# parses it at boot. Share target Drive folders/docs with the service account
# email so it can read/write.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Folder ID used by save_to_drive when no destination is specified
GOOGLE_DRIVE_DEFAULT_FOLDER_ID=

# --- Salesforce (optional, v1 context lookups) ---
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=

# --- Worker schedule (optional, defaults are weekday 9am Pacific) ---
DIGEST_CRON=0 9 * * 1-5
DIGEST_TIMEZONE=America/Los_Angeles
